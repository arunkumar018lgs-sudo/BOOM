// server.js
const express = require('express');
const cors = require('cors');
const app = express();

app.use(cors());
app.use(express.json());

// Mock database for demonstration
const users = [
  { id: 1, name: 'Alex', bio: 'Love hiking and coffee.', age: 28 },
  { id: 2, name: 'Jordan', bio: 'Avid reader and traveler.', age: 26 }
];

// API Endpoint: Get potential matches
app.get('/api/recommendations/:userId', (req, res) => {
  const { userId } = req.params;
  
  // In a real app, you would query your database here, 
  // filtering out people the user has already swiped on.
  const recommendations = users.filter(u => u.id !== parseInt(userId));
  
  res.status(200).json({
    success: true,
    data: recommendations
  });
});

// API Endpoint: Handle a swipe action
app.post('/api/swipe', (req, res) => {
  const { swiperId, swipeeId, action } = req.body;
  // Logic to record the swipe in the database
  // Logic to check if the swipee already "liked" the swiper (It's a Match!)
  
  res.status(200).json({ message: `Successfully registered ${action} on user ${swipeeId}` });
});

const PORT = process.env.PORT || 5000;
app.listen(PORT, () => console.log(`Server running on port ${PORT}`));
